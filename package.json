{
  "name": "trackmydex",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hostable Pokemon TCG collection tracker and portfolio manager",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "sync:catalog": "tsx src/scripts/sync-catalog.ts",
    "sync:new": "tsx src/scripts/sync-new-cards.ts",
    "sync:prices": "tsx src/scripts/sync-prices.ts",
    "sync:snapshots": "tsx src/scripts/snapshot.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "mirror:assets": "tsx src/scripts/mirror-assets.ts",
    "start:prepare": "node scripts/prepare-standalone.mjs",
    "scan:index": "tsx src/scripts/index-artwork.ts",
    "sync:sealed": "tsx src/scripts/sync-sealed.ts",
    "audit:images": "tsx src/scripts/audit-images.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.7.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
