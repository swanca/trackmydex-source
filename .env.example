# ---------------------------------------------------------------------------
# TrackMyDex — environment template
# Copy to `.env` (local dev) or `.env.production` and fill in.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------

# PostgreSQL connection string. Any Postgres 14+ host works (Docker, Neon,
# Supabase, RDS...). Append `?sslmode=require` for managed providers.
DATABASE_URL=postgres://trackmydex:trackmydex@localhost:5432/trackmydex

# Public origin of the deployment. Used for auth callbacks, e-mail links,
# CSRF origin checks and the PWA manifest.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign sessions and tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# --- Auth behaviour (optional) --------------------------------------------

# Require users to confirm their address before signing in.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Allow new signups. Set to false to lock down a private instance after
# creating your own account.
AUTH_ALLOW_SIGNUP=true

# E-mail addresses (comma separated) that are granted the admin role on signup.
ADMIN_EMAILS=

# SMTP for password-reset and verification mail. If unset, the app logs the
# links to stdout instead of sending them - fine for a single-user instance.
SMTP_URL=
SMTP_FROM="TrackMyDex <no-reply@example.com>"

# Google OAuth. Leave blank to keep e-mail/password only; filling these in is
# the only change needed to enable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Catalog provider ------------------------------------------------------

# TCGdex needs no key. Override only if you self-host the open-source API.
TCGDEX_API_URL=https://api.tcgdex.net/v2

# Printed card languages to ingest, in priority order. Trim this list to cut
# sync time and database size; `en` is required as the canonical pass.
#
# This is the language printed on the cardboard, and is separate from the
# interface language (en, fr, es, pt, it, ja), which each user picks themselves.
CATALOG_LANGUAGES=en,fr,es,pt,it,ja,de,ko,zh-tw,zh-cn

# Max concurrent upstream requests during a sync. Keep this modest - TCGdex is
# a free community service.
SYNC_CONCURRENCY=6

# --- Pricing providers -----------------------------------------------------

# Default (free, no key): reads the Cardmarket + TCGplayer aggregates embedded
# in the TCGdex card payload.
PRICING_PROVIDERS=tcgdex

# A price refresh covers the ENTIRE catalog by default - roughly 24,000 upstream
# requests, 20-40 minutes at the concurrency above. Set a positive number only
# if a run must fit in a shorter window; the job prioritises owned and
# wishlisted printings, then the newest sets, so a capped run still refreshes
# what people actually look at.
PRICE_SYNC_MAX_VARIANTS=0

# Optional secondary provider. pokemontcg.io was returning 5xx at the time of
# writing - enable at your own risk.
POKEMONTCGIO_API_KEY=

# Display currency for portfolio totals (EUR or USD).
DEFAULT_CURRENCY=EUR

# EUR -> USD rate used when a price must be converted. Refreshed by the
# snapshot job if FX_RATE_URL is set, otherwise this static value is used.
FX_EUR_USD=1.08
FX_RATE_URL=

# --- Jobs ------------------------------------------------------------------

# Which prices get a daily history row.
#
#   tracked  (default) only what a user owns or wishlists. A personal instance
#            grows by kilobytes a day, which is what makes a free Postgres
#            tier workable.
#   all      every priced printing and sealed product: ~69,000 rows and 19 MB
#            per day, 7 GB per year. Right for a public instance where any
#            visitor may open any card.
PRICE_HISTORY_SCOPE=tracked

# How long price history stays at daily resolution. Beyond this, the daily job
# thins older readings to one per week, which is what stops the table growing
# for ever: scoping alone still writes a row per tracked card per day.
# A 5,000-card collection goes from ~500 MB/year to ~70 MB/year.
PRICE_HISTORY_DAILY_DAYS=120

# Hard limit: history older than this is deleted outright. 0 keeps it for ever,
# which is safe once thinning is on.
PRICE_HISTORY_RETENTION_DAYS=0

# --- Pages legales ---------------------------------------------------------
# Les seuls faits qui dependent de l'exploitant. Le reste des documents decrit
# ce que le logiciel fait, ce qui est connu et deja ecrit.
# Laisses vides : l'editeur et le contact retombent sur le domaine d'APP_URL
# (par ex. contact@trackmydex.com), l'adresse et le droit applicable affichent
# un marqueur et la page signale qu'elle est incomplete.
LEGAL_PUBLISHER=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=

# Shared secret for POST /api/cron/* so an external scheduler can trigger jobs.
CRON_SECRET=

# --- Observability ---------------------------------------------------------

# `debug` | `info` | `warn` | `error`
LOG_LEVEL=info

# Optional Sentry DSN. The logger is Sentry-compatible but Sentry is not a
# dependency; leaving this blank disables reporting entirely.
SENTRY_DSN=
